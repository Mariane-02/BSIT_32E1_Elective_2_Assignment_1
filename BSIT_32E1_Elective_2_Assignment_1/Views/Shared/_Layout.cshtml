<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BSIT 32E1 Elective 2</title>
    <style>
        :root { --bg:#fff; --fg:#1f2430; --muted:#667085; --card:#f6f7f9; --ok:#e3f6e8; --okb:#2e9e56; --line:#dde1e7; }
        @@media (prefers-color-scheme: dark) {
            :root { --bg:#16181d; --fg:#e8eaee; --muted:#9aa3b2; --card:#1f232b; --ok:#16341f; --okb:#3fb56b; --line:#333a46; }
        }
        body { margin:0; font-family: system-ui, Segoe UI, sans-serif; background:var(--bg); color:var(--fg); line-height:1.5; }
        header { padding:1.5rem 1rem; border-bottom:1px solid var(--line); text-align:center; }
        header h1 { margin:0; font-size:1.4rem; }
        header p { margin:.25rem 0 0; color:var(--muted); }
        main { max-width:820px; margin:0 auto; padding:1rem; }
    </style>
</head>
<body>
    <header>
        <h1>BSIT_32E1_Elective_2_Assignment_1</h1>
        <p>ASP.NET Core MVC vs. Web API: Questions and Answers</p>
    </header>
    <main>@RenderBody()</main>
</body>
</html>
